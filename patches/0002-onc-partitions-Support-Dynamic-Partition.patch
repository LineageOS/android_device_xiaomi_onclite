From 2a6e5785848ba701c951bb065b0fc41da7a3572f Mon Sep 17 00:00:00 2001
From: ColdWindScholar <3590361911@qq.com>
Date: Fri, 1 May 2026 20:34:39 +0800
Subject: [PATCH 2/2] onc: partitions: Support Dynamic Partition

Change-Id: I32720b06722960b51b3ab0dce4b1500113afc8d2
---
 BoardConfig.mk                | 56 ++++++++++++++++++++++++++---------
 device.mk                     |  6 +++-
 rootdir/Android.mk            |  1 -
 rootdir/etc/fstab.qcom        | 13 ++++----
 sepolicy/vendor/device.te     |  1 +
 sepolicy/vendor/file.te       |  2 +-
 sepolicy/vendor/file_contexts |  9 ++++--
 7 files changed, 64 insertions(+), 24 deletions(-)

diff --git a/BoardConfig.mk b/BoardConfig.mk
index 276a6c0..789b711 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -105,16 +105,16 @@ TARGET_RECOVERY_DEVICE_MODULES := libinit_onclite
 BOARD_KERNEL_BASE := 0x80000000
 BOARD_KERNEL_CMDLINE := \
     androidboot.bootdevice=7824900.sdhci \
-    androidboot.console=ttyMSM0 \
+    androidboot.android_dt_dir=/non-existent \
     androidboot.hardware=qcom \
     androidboot.usbconfigfs=true \
-    console=ttyMSM0,115200,n8 \
     earlycon=msm_serial_dm,0x78af000 \
     ehci-hcd.park=3 \
     firmware_class.path=/vendor/firmware_mnt/image \
     loop.max_part=7 \
     lpm_levels.sleep_disabled=1 \
-    msm_rtb.filter=0x237
+    msm_rtb.filter=0x237 \
+    androidboot.init_fatal_reboot_target=recovery printk.devkmsg=on androidboot.boot_devices=soc/7824900.sdhci
 BOARD_KERNEL_IMAGE_NAME := Image.gz-dtb
 BOARD_KERNEL_PAGESIZE :=  2048
 BOARD_BOOTIMG_HEADER_VERSION := 1
@@ -126,23 +126,47 @@ BOARD_DTBOIMG_PARTITION_SIZE := 8388608
 TARGET_KERNEL_VERSION := 4.9
 
 # Partitions
+SSI_PARTITIONS := product system system_ext
+TREBLE_PARTITIONS := odm vendor
+ALL_PARTITIONS := $(SSI_PARTITIONS) $(TREBLE_PARTITIONS)
+
+$(foreach p, $(call to-upper, $(ALL_PARTITIONS)), \
+    $(eval BOARD_$(p)IMAGE_FILE_SYSTEM_TYPE := ext4) \
+    $(eval TARGET_COPY_OUT_$(p) := $(call to-lower, $(p))))
 BOARD_FLASH_BLOCK_SIZE := 131072 # (BOARD_KERNEL_PAGESIZE * 64)
 
 BOARD_BOOTIMAGE_PARTITION_SIZE := 67108864
 BOARD_CACHEIMAGE_PARTITION_SIZE := 268435456
-BOARD_SYSTEMIMAGE_PARTITION_SIZE := 3758096384
 BOARD_RECOVERYIMAGE_PARTITION_SIZE := 67108864
-BOARD_USERDATAIMAGE_PARTITION_SIZE := 24222088704
-BOARD_VENDORIMAGE_PARTITION_SIZE := 1073741824
+BOARD_USERDATAIMAGE_PARTITION_SIZE := 1966587904
 
 TARGET_USERIMAGES_USE_F2FS := true
 TARGET_USERIMAGES_USE_EXT4 := true
 
 BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4
-BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
-
-TARGET_COPY_OUT_VENDOR := vendor
-
+BOARD_USES_METADATA_PARTITION := true
+BOARD_SUPER_PARTITION_BLOCK_DEVICES := cust system vendor
+BOARD_SUPER_PARTITION_METADATA_DEVICE := system
+BOARD_SUPER_PARTITION_CUST_DEVICE_SIZE := 536870912
+BOARD_SUPER_PARTITION_SYSTEM_DEVICE_SIZE := 3221225472
+BOARD_SUPER_PARTITION_VENDOR_DEVICE_SIZE := 1073741824
+BOARD_SUPER_PARTITION_SIZE := $(shell expr $(BOARD_SUPER_PARTITION_CUST_DEVICE_SIZE) + $(BOARD_SUPER_PARTITION_SYSTEM_DEVICE_SIZE) + $(BOARD_SUPER_PARTITION_VENDOR_DEVICE_SIZE) )
+BOARD_SUPER_PARTITION_GROUPS := onc_dynpart
+BOARD_ONC_DYNPART_SIZE := $(shell expr $(BOARD_SUPER_PARTITION_SIZE) - 4194304 )
+BOARD_ONC_DYNPART_PARTITION_LIST := $(ALL_PARTITIONS)
+$(foreach p, $(call to-upper, $(SSI_PARTITIONS)), \
+    $(eval BOARD_$(p)IMAGE_EXTFS_INODE_COUNT := -1))
+
+BOARD_ODMIMAGE_EXTFS_INODE_COUNT := 128
+BOARD_VENDORIMAGE_EXTFS_INODE_COUNT := 6144
+
+$(foreach p, $(call to-upper, $(SSI_PARTITIONS)), \
+    $(eval BOARD_$(p)IMAGE_PARTITION_RESERVED_SIZE := 83886080)) # 80 MB
+$(foreach p, $(call to-upper, $(TREBLE_PARTITIONS)), \
+    $(eval BOARD_$(p)IMAGE_PARTITION_RESERVED_SIZE := 41943040)) # 40 MB
+
+BOARD_ROOT_EXTRA_SYMLINKS := \
+    /vendor/dsp:/dsp
 # Peripheral manager
 TARGET_PER_MGR_ENABLED := true
 
@@ -179,14 +203,18 @@ BOARD_VENDOR_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/vendor
 # Treble
 BOARD_VNDK_VERSION := current
 PRODUCT_VENDOR_MOVE_ENABLED := true
-
+# Fastboot 
+TARGET_BOARD_FASTBOOT_INFO_FILE := $(DEVICE_PATH)/fastboot-info.txt
 # Verified Boot
 BOARD_AVB_ENABLE := true
-BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --set_hashtree_disabled_flag
-BOARD_AVB_RECOVERY_KEY_PATH := external/avb/test/data/testkey_rsa4096.pem
-BOARD_AVB_RECOVERY_ALGORITHM := SHA256_RSA4096
+BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --set_hashtree_disabled_flag --flags 3
+#BOARD_AVB_RECOVERY_KEY_PATH := external/avb/test/data/testkey_rsa4096.pem
+#BOARD_AVB_RECOVERY_ALGORITHM := SHA256_RSA409
 BOARD_AVB_RECOVERY_ROLLBACK_INDEX := 1
 BOARD_AVB_RECOVERY_ROLLBACK_INDEX_LOCATION := 1
+#//
+BOARD_AVB_RECOVERY_KEY_PATH := external/avb/test/data/testkey_rsa2048.pem
+BOARD_AVB_RECOVERY_ALGORITHM := SHA256_RSA2048
 
 # Wi-Fi
 BOARD_HOSTAPD_DRIVER := NL80211
diff --git a/device.mk b/device.mk
index 8ad8616..cdefee6 100644
--- a/device.mk
+++ b/device.mk
@@ -60,7 +60,10 @@ PRODUCT_PACKAGES += \
 # Boot animation
 TARGET_SCREEN_HEIGHT := 1520
 TARGET_SCREEN_WIDTH := 720
-
+# Dynamic Partitions
+PRODUCT_BUILD_SUPER_PARTITION := false
+PRODUCT_USE_DYNAMIC_PARTITIONS := true
+PRODUCT_RETROFIT_DYNAMIC_PARTITIONS := true
 # Camera
 PRODUCT_PACKAGES += \
     android.frameworks.sensorservice@1.0.vendor \
@@ -84,6 +87,7 @@ $(call inherit-product, frameworks/native/build/phone-xhdpi-2048-dalvik-heap.mk)
 # Display
 PRODUCT_PACKAGES += \
     android.frameworks.displayservice@1.0.vendor \
+    fstab.qcom_ramdisk \
     android.hardware.graphics.allocator@2.0-impl \
     android.hardware.graphics.allocator@2.0-service \
     android.hardware.graphics.composer@2.1-service \
